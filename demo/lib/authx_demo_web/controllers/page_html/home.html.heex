<Layouts.app flash={@flash}>
  <div class="demo-card">
    <p class="eyebrow">AUTHX / OIDC DEMO</p>
    <%= if @current_user do %>
      <h1>身份连接成功</h1>
      <p class="intro">这是 Authx 中统一管理的用户身份，当前应用不会保存您的 Authx 密码。</p>
      <dl class="identity">
        <div>
          <dt>用户 ID</dt><dd id="authx-user-id">{@current_user.subject}</dd>
        </div>
        <div>
          <dt>邮箱</dt><dd id="authx-user-email">{@current_user.email}</dd>
        </div>
        <div>
          <dt>签发方</dt><dd id="authx-issuer">{@current_user.issuer}</dd>
        </div>
      </dl>
      <.form for={%{}} action={~p"/sign-out"} method="post" id="sign-out-form">
        <button type="submit" class="button secondary">退出当前应用</button>
      </.form>
      <p class="note">退出当前应用不会退出 Authx。</p>
    <% else %>
      <h1>一个身份，<br />无缝连接。</h1>
      <p class="intro">使用 Authx 安全登录，体验跨应用统一身份认证。</p>
      <a id="authx-sign-in" class="button primary" href="/auth/user/authx">
        使用 Authx 登录 <span aria-hidden="true">→</span>
      </a>
      <p class="note">您将在 Authx 完成登录与授权。</p>
    <% end %>
  </div>
</Layouts.app>
