<Layouts.app flash={@flash}>
  <div id="home-page" class="overflow-hidden bg-[#fafbf8] text-[#18271f]">
    <section class="relative mx-auto grid max-w-7xl items-center gap-14 px-5 pt-16 pb-20 sm:px-8 sm:pt-24 lg:grid-cols-2 lg:gap-16 lg:px-12 lg:pt-28 lg:pb-32">
      <div class="relative z-10 max-w-xl">
        <div class="inline-flex items-center gap-2 rounded-full border border-[#dbe7d9] bg-[#f0f6ec] px-3 py-1.5 text-xs font-semibold tracking-wide text-[#426b4c]">
          <span class="size-1.5 rounded-full bg-[#70a976]"></span> 一处身份，多处连接
        </div>
        <h1 class="mt-7 text-[2.75rem] leading-[1.16] font-semibold tracking-[-0.06em] text-balance sm:text-6xl lg:text-[4.25rem]">
          让身份认证，<br />
          <span class="text-[#659776]">简单一点。</span>
        </h1>
        <p class="mt-6 max-w-md text-base leading-8 text-[#68766b] sm:text-lg">
          Authx 是基于 Phoenix 和 Ash 构建的身份服务。
          集中管理登录，让每个应用都能专注于自己的事情。
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <%= if assigns[:current_user] do %>
            <.link
              href={~p"/sign-out"}
              id="home-sign-out"
              class="inline-flex items-center gap-3 rounded-full bg-[#1d4936] px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-[#2f6048] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3a7053]"
            >
              退出登录 <.icon name="hero-arrow-right" class="size-4" />
            </.link>
          <% else %>
            <.link
              href={~p"/sign-in"}
              id="home-sign-in"
              class="inline-flex items-center gap-3 rounded-full bg-[#1d4936] px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-[#2f6048] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3a7053]"
            >
              登录 Authx <.icon name="hero-arrow-right" class="size-4" />
            </.link>
          <% end %>
          <a
            href="#about"
            class="inline-flex items-center gap-2 rounded-full px-3 py-3 text-sm font-semibold text-[#4c6553] transition-colors hover:text-[#173b2a] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#3a7053]"
          >
            了解更多 <.icon name="hero-arrow-down" class="size-4" />
          </a>
        </div>
        <div class="mt-12 flex items-center gap-3 text-xs font-medium tracking-wide text-[#8a988d]">
          <span class="h-px w-8 bg-[#ccd8cb]"></span> BUILT WITH PHOENIX + ASH
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-lg lg:max-w-none">
        <div class="absolute inset-5 rounded-full bg-[#dbead6] blur-3xl"></div>
        <div class="relative overflow-hidden rounded-[2rem] border border-[#dfe8db] bg-[#edf4e9] p-5 sm:p-8">
          <div class="absolute -top-20 -right-20 size-64 rounded-full border border-[#cbdcc7]">
          </div>
          <div class="absolute -top-12 -right-12 size-64 rounded-full border border-[#d5e4d1]">
          </div>
          <div class="relative rounded-2xl border border-white/80 bg-white/90 p-6 shadow-[0_20px_65px_-30px_rgba(32,70,43,0.28)] sm:p-8">
            <div class="flex items-start justify-between gap-4">
              <div class="flex size-11 items-center justify-center rounded-2xl bg-[#e7f2e3] text-[#39714b]">
                <.icon name="hero-shield-check" class="size-6" />
              </div>
              <span class="rounded-full border border-[#e7eee4] bg-[#f8faf6] px-3 py-1 text-[11px] font-semibold text-[#839287]">
                身份流程示意
              </span>
            </div>
            <p class="mt-8 text-xs font-semibold tracking-[0.16em] text-[#8a998e]">
              YOUR IDENTITY
            </p>
            <h2 class="mt-2 text-2xl font-semibold tracking-tight">一个账号，连接更多。</h2>
            <p class="mt-2 text-sm leading-6 text-[#829087]">让登录体验保持一致，让应用之间的连接更从容。</p>
            <div class="mt-7 space-y-3">
              <div class="flex items-center gap-3 rounded-xl border border-[#e9eee7] bg-[#fafcf9] p-3.5">
                <span class="flex size-9 items-center justify-center rounded-lg bg-[#edf5eb] text-[#51805a]">
                  <.icon name="hero-user-circle" class="size-5" />
                </span>
                <div>
                  <p class="text-sm font-semibold">你的账号</p>
                  <p class="mt-0.5 text-xs text-[#8a998e]">密码或 Magic Link 登录</p>
                </div>
              </div>
              <div class="flex items-center gap-3 rounded-xl border border-[#e9eee7] bg-[#fafcf9] p-3.5">
                <span class="flex size-9 items-center justify-center rounded-lg bg-[#edf5eb] text-[#51805a]">
                  <.icon name="hero-squares-2x2" class="size-5" />
                </span>
                <div>
                  <p class="text-sm font-semibold">你的应用</p>
                  <p class="mt-0.5 text-xs text-[#8a998e]">OIDC 接入规划中</p>
                </div>
              </div>
            </div>
          </div>
          <div class="relative flex items-center justify-between px-1 pt-5 text-[11px] font-semibold tracking-[0.14em] text-[#879b88]">
            <span>AUTHX / IDENTITY</span>
            <.icon name="hero-sparkles" class="size-4" />
          </div>
        </div>
      </div>
    </section>

    <section id="about" class="border-t border-[#e6ece3] bg-white">
      <div class="mx-auto max-w-7xl px-5 py-16 sm:px-8 sm:py-20 lg:px-12">
        <div class="grid gap-8 lg:grid-cols-[1fr_2fr] lg:gap-16">
          <div>
            <p class="text-xs font-semibold tracking-[0.16em] text-[#719576]">ABOUT AUTHX</p>
            <h2 class="mt-3 text-2xl font-semibold tracking-tight">为连接而构建。</h2>
          </div>
          <div class="grid gap-8 sm:grid-cols-2">
            <div>
              <div class="flex size-10 items-center justify-center rounded-xl bg-[#f0f6ed] text-[#578064]">
                <.icon name="hero-finger-print" class="size-5" />
              </div>
              <h3 class="mt-4 text-base font-semibold">统一的登录入口</h3>
              <p class="mt-2 text-sm leading-7 text-[#78877c]">
                使用密码或邮件 Magic Link 登录，在一处管理身份。
              </p>
            </div>
            <div>
              <div class="flex size-10 items-center justify-center rounded-xl bg-[#f0f6ed] text-[#578064]">
                <.icon name="hero-link" class="size-5" />
              </div>
              <h3 class="mt-4 text-base font-semibold">面向更多应用</h3>
              <p class="mt-2 text-sm leading-7 text-[#78877c]">
                正在规划 OIDC 接入，为不同技术栈的应用提供统一身份服务。
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <footer class="border-t border-[#e6ece3] bg-white">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-5 py-7 text-xs text-[#8a998e] sm:px-8 lg:px-12">
        <span class="font-semibold tracking-tight text-[#55705d]">authx.</span>
        <span>用心构建，简单连接。</span>
      </div>
    </footer>
  </div>
</Layouts.app>
